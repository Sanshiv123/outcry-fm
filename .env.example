# Default is a fully labeled simulation; no provider keys needed.
MOCK_MODE=true
PORT=4747
MAX_ORDER_USD=5
MAX_DAILY_USD=20
MAX_STATION_USD=50
# Voice standing orders ("buy 1 dollar of SOL every time it drops below 98").
# Armed once by the caller, then executed automatically within the caps above. false = kill switch.
STANDING_ORDERS=true
STANDING_MAX_FILLS=3
# Extra tip-only assets not on the trading allowlist, e.g. a stablecoin the station wallet
# actually holds. Never shown as a "buy" card; tip/send only.
EXTRA_CASH_ASSETS=
# Crowd Calls: free bull/bear rounds read out on air (no funds move).
CROWD_CALLS=true
CROWD_ROUND_SECONDS=120
# Verified symbols + chains resolved through Gateway's catalog, never guessed IDs.
TM_TOKENS=SOL,CBBTC@base
# Tensho uses the downloaded organization key JSON, not a plain API token.
TM_API_KEY_PATH=.secrets
# Optional existing P-256 signer: file containing a 64-character hex scalar.
# Otherwise generated in data/<mock|live>/wallet-signer-key. BACK IT UP.
SIGNER_KEY_PATH=
# Compatibility/documentation only: not consumed; use TM_API_KEY_PATH above.
TRUEMARKETS_API_KEY=
ENABLE_GROK=false
XAI_API_KEY=
XAI_MODEL=grok-4
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_VOICE_A=
ELEVENLABS_VOICE_B=
# Optional: generate one pit bell on startup (provider usage).
ENABLE_SOUND_EFFECTS=false
STATION_WALLET_SOLANA=
STATION_WALLET_EVM=
# Optional override; separate mock/live directories are selected by default.
DATA_FILE=
# Reserved for a database migration; current prototype uses durable JSON files.
DATABASE_URL=
